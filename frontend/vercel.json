{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://graam-gyaan-api.onrender.com/api/:path*"},
    {"source": "/healthz", "destination": "https://graam-gyaan-api.onrender.com/healthz"},
    {"source": "/((?!assets/|api/|healthz|sw.js|manifest.json|icon-).*)", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "private, no-store"}]}
  ]
}
