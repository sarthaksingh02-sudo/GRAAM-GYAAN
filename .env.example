# -- Sarvam AI ------------------------------------------------------------------
# Get your key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Set to "true" to run fully offline with canned mock responses.
# Mock outputs are clearly flagged in logs and UI; never pass as real in demos.
SARVAM_MOCK=false
DEMO_CACHE=0

# -- Cache ----------------------------------------------------------------------
# Optional on-disk cache; live personal chat/STT/TTS calls disable it by default
SARVAM_CACHE_DIR=.cache/sarvam

# -- Database -------------------------------------------------------------------
DATABASE_URL=sqlite:///./graam_gyaan.db

# -- App ------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=true

# Public hosting (local default remains single-device)
DEPLOYMENT_MODE=local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
# DATA_DIR=/var/data
