# -- Sarvam AI ------------------------------------------------------------------
# Get your key at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Set to "true" to run fully offline with canned mock responses.
# Mock outputs are clearly flagged in logs and UI; never pass as real in demos.
SARVAM_MOCK=false

# -- Cache ----------------------------------------------------------------------
# Directory for on-disk AI response cache (speeds up repeated dev calls)
SARVAM_CACHE_DIR=.cache/sarvam

# -- Database -------------------------------------------------------------------
DATABASE_URL=sqlite:///./graam_gyaan.db

# -- App ------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=true
